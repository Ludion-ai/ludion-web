{
  "name": "@ludion/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate && vite --port 5173 --strictPort",
    "build": "tsc --noEmit && tsc -p worker && vite build",
    "build:deploy": "tsc --noEmit && tsc -p worker && vite build --mode deploy",
    "preview": "npm run db:migrate && vite preview --port 4173 --strictPort",
    "db:migrate": "node scripts/migrate.mjs",
    "deploy": "node scripts/deploy-guard.mjs && npm run build:deploy && node scripts/deploy-guard.mjs && node scripts/migrate.mjs --remote && wrangler deploy",
    "deploy:www": "node scripts/deploy-guard.mjs && wrangler deploy -c www-redirect/wrangler.jsonc",
    "seed:dev": "npm run db:migrate && node scripts/seed-dev.mjs",
    "shots": "node scripts/shots.mjs",
    "shots:pages": "node scripts/shots-pages.mjs",
    "shots:accounts": "node scripts/shots-accounts.mjs",
    "test": "playwright test",
    "lcp": "node scripts/lcp.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/webp": "^1.5.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "hono": "^4.13.17",
    "jose": "^6.2.16",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@cloudflare/vite-plugin": "^1.67.0",
    "@cloudflare/workers-types": "^5.20261108.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2",
    "undici": "^7.30.1",
    "vite": "^8.3.5",
    "wrangler": "^4.158.0"
  }
}
